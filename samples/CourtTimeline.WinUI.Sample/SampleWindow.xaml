<Window
    x:Class="CourtTimeline.Sample.SampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:court="using:CourtTimeline"
    Title="CourtTimeline — визуальная проверка">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,16,24,14" Spacing="10">
      <TextBlock Text="Судебный таймлайн" FontSize="20" FontWeight="SemiBold" />
      <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ComboBox x:Name="ScenarioPicker" Header="Набор данных" Width="260"
                    SelectionChanged="Scenario_Changed"
                    AutomationProperties.AutomationId="ScenarioPicker" />
          <ComboBox x:Name="ThemePicker" Header="Тема" Width="140" SelectedIndex="0"
                    SelectionChanged="Theme_Changed" AutomationProperties.AutomationId="ThemePicker">
            <ComboBoxItem Content="Системная" />
            <ComboBoxItem Content="Светлая" />
            <ComboBoxItem Content="Тёмная" />
          </ComboBox>
          <ComboBox x:Name="LanguagePicker" Header="Язык компонента" Width="155" SelectedIndex="0"
                    SelectionChanged="Language_Changed" AutomationProperties.AutomationId="LanguagePicker">
            <ComboBoxItem Content="Русский" />
            <ComboBoxItem Content="English" />
          </ComboBox>
          <CheckBox x:Name="LiveNowToggle" Content="Сейчас" VerticalAlignment="Bottom" Margin="0,0,0,6"
                    Checked="LiveNow_Changed" Unchecked="LiveNow_Changed"
                    AutomationProperties.AutomationId="LiveNowToggle" />
          <CalendarDatePicker x:Name="NowDate" Header="Дата «сегодня»" Width="168"
                              DateChanged="NowDate_Changed" AutomationProperties.AutomationId="NowDate"
                              ToolTipService.ToolTip="Календарный день линии. Линия стоит на начале этого дня, и день целиком считается фактом." />
          <TimePicker x:Name="NowTime" Header="Время" Width="132" ClockIdentifier="24HourClock" MinuteIncrement="1"
                      SelectedTimeChanged="NowTime_Changed" AutomationProperties.AutomationId="NowTime"
                      ToolTipService.ToolTip="Время только в подписи. Линию и границу факта оно не сдвигает." />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="HeaderToggle" Content="Шапка дела" IsChecked="True"
                  Checked="Panels_Changed" Unchecked="Panels_Changed" />
        <CheckBox x:Name="DetailsToggle" Content="Детали" IsChecked="True"
                  Checked="Panels_Changed" Unchecked="Panels_Changed" />
        <Button Content="Сбросить" Click="Reset_Click" AutomationProperties.AutomationId="ResetSample" />
      </StackPanel>
      <TextBlock x:Name="ScenarioNote" FontSize="12" TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <court:CourtTimelineView x:Name="Timeline" Grid.Row="1" />
    <Border Grid.Row="2" Padding="24,10" BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <TextBlock x:Name="SelectionStatus" FontSize="12" TextTrimming="CharacterEllipsis"
                 Text="Ничего не выбрано" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
